rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /businesses/{ownerId}/{businessId}/branding/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == ownerId;
    }

    match /businesses/{ownerId}/{businessId}/materials/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == ownerId;
    }
  }
}
